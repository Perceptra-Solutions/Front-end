# Copie para .env.local e ajuste se a API não estiver em localhost:3000.
# .env.local não é versionado (ver .gitignore).

VITE_API_URL=http://localhost:3000/api/v1

# Usuário fixo usado pelo app inteiro nesta versão sem tela de login (ver
# src/lib/api/client.ts). Precisa existir no banco — os usuários abaixo vêm
# do seed (npm run db:seed no backend), senha única "perceptra123".
#
# ATENÇÃO: nenhum usuário faz TUDO, e isso é o backend funcionando como
# projetado (papéis são checados de verdade, não decorativos):
#
#   ana@perceptra.dev      ENGENHEIRO  tria detecção, cria plano de ação.
#                                      NÃO emite relatório (403).
#   bruno@perceptra.dev    ENGENHEIRO  o segundo engenheiro — é ele que
#                                      verifica a ação da Ana (segregação
#                                      de função).
#   gestora@perceptra.dev  GESTOR      emite relatório, cancela NC, mantém
#                                      cadastros. NÃO tria detecção (403):
#                                      triagem é ato técnico.
#
# O front lida com isso mostrando a ação desabilitada com o motivo, em vez
# de deixar clicar e tomar 403. Para demonstrar a emissão de relatório,
# troque para gestora@perceptra.dev.
VITE_DEMO_EMAIL=ana@perceptra.dev
VITE_DEMO_SENHA=perceptra123
